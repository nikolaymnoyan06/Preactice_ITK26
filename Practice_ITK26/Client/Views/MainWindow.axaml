<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Граф">

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<StackPanel Margin="20">
		<TextBlock Text="{Binding Greeting}" HorizontalAlignment="Center" FontSize="16"/>

		<!-- Список узлов -->
		<ListBox ItemsSource="{Binding Nodes}"
                 SelectedItem="{Binding SelectedNode}"
                 DisplayMemberBinding="{Binding Value}"
                 Height="200" Margin="0,10,0,10"/>

		<!-- Поля для добавления -->
		<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5">
			<TextBox Width="100" Watermark="ID" Text="{Binding NewNodeId}"/>
			<TextBox Width="200" Watermark="Value" Text="{Binding NewNodeValue}"/>
			<Button Content="Добавить" Command="{Binding AddNodeCommand}"/>
		</StackPanel>

		<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5">
			<TextBox Width="80" Watermark="Кол-во" Text="{Binding GenerateCount}"/>
			<Button Content="Сгенерировать" Command="{Binding GenerateNodesCommand}"/>
		</StackPanel>

		<!-- Кнопка удаления -->
		<Button Content="Удалить выбранный" Command="{Binding DeleteNodeCommand}"
                HorizontalAlignment="Left" Margin="0,10,0,0"/>

		<!-- Кнопка обновления (на всякий случай) -->
		<Button Content="Обновить" Command="{Binding LoadNodesCommand}"
                HorizontalAlignment="Left" Margin="0,5,0,0"/>
		<!-- Блок рёбер -->
		<TextBlock Text="Рёбра" FontWeight="Bold" Margin="0,15,0,5"/>
		<ListBox ItemsSource="{Binding Edges}"
				 SelectedItem="{Binding SelectedEdge}"
				 Height="100" Margin="0,5,0,5">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding}" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5">
			<TextBox  Width="60" Watermark="Source" Text="{Binding NewEdgeSource, UpdateSourceTrigger=PropertyChanged}"/>
			<TextBox  Width="60" Watermark="Target" Text="{Binding NewEdgeTarget, UpdateSourceTrigger=PropertyChanged}"/>
			<TextBox  Width="60" Watermark="Weight" Text="{Binding NewEdgeWeight, UpdateSourceTrigger=PropertyChanged}"/>
			<Button  Content="Добавить ребро" Command="{Binding AddEdgeCommand}"/>
		</StackPanel>

		<Button Content="Удалить выбранное ребро" Command="{Binding DeleteEdgeCommand}"
				HorizontalAlignment="Left" Margin="0,5,0,0"/>
		<Button Content="Обновить рёбра" Command="{Binding LoadEdgesCommand}"
				HorizontalAlignment="Left" Margin="0,5,0,0"/>
	</StackPanel>
</Window>