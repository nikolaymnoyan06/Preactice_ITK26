<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dg="using:Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Граф - Управление узлами и рёбрами">

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<TabControl Margin="10">
		<!-- Вкладка 1: Управление графом -->
		<TabItem Header="Управление">
	
	<Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

		<!-- Заголовок -->
		<TextBlock Grid.Row="0" Text="{Binding Greeting}"
                   HorizontalAlignment="Center" FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,15"/>

		<!-- ========== БЛОК УЗЛОВ ========== -->
		<TextBlock Grid.Row="1" Text="📊 Узлы (Nodes)"
                   FontWeight="Bold" FontSize="14" Margin="0,5,0,5"/>

		<!-- ТАБЛИЦА УЗЛОВ -->
		<dg:DataGrid Grid.Row="2"
                     ItemsSource="{Binding Nodes}"
                     SelectedItem="{Binding SelectedNode}"
                     AutoGenerateColumns="False"
                     CanUserResizeColumns="True"
                     CanUserReorderColumns="True"
                     CanUserSortColumns="True"
                     GridLinesVisibility="All"
                     BorderThickness="1"
                     MinHeight="150"
                     MaxHeight="250"
                     Margin="0,0,0,10">
			<dg:DataGrid.Columns>
				<dg:DataGridTextColumn Header="ID"
                                       Binding="{Binding Id}"
                                       Width="60"/>
				<dg:DataGridTextColumn Header="Значение"
                                       Binding="{Binding Value}"
                                       Width="*"/>
				<dg:DataGridTextColumn Header="Тип"
                                       Binding="{Binding Type}"
                                       Width="100"/>
			</dg:DataGrid.Columns>
		</dg:DataGrid>

		<!-- Панель управления узлами -->
		<StackPanel Grid.Row="3" Spacing="5" Margin="0,5,0,10">
			<!-- Добавление узла -->
			<StackPanel Orientation="Horizontal" Spacing="10">
				<TextBox Width="100" Watermark="ID" Text="{Binding NewNodeId}"/>
				<TextBox Width="200" Watermark="Значение" Text="{Binding NewNodeValue}"/>
				<ComboBox Width="120"
                          ItemsSource="{Binding NodeTypes}"
                          SelectedItem="{Binding SelectedNodeType}"/>
				<Button Content="➕ Добавить узел"
                        Command="{Binding AddNodeCommand}"/>
			</StackPanel>

			<!-- Генерация и удаление -->
			<StackPanel Orientation="Horizontal" Spacing="10">
				<TextBox Width="80" Watermark="Кол-во" Text="{Binding GenerateCount}"/>
				<Button Content="🎲 Сгенерировать"
                        Command="{Binding GenerateNodesCommand}"/>
				<Button Content="❌ Удалить выбранный"
                        Command="{Binding DeleteNodeCommand}"/>
				<Button Content="🔄 Обновить"
                        Command="{Binding LoadNodesCommand}"/>
			</StackPanel>
		</StackPanel>

		<!-- ========== БЛОК РЁБЕР ========== -->
		<TextBlock Grid.Row="4" Text="🔗 Рёбра (Edges)"
                   FontWeight="Bold" FontSize="14" Margin="0,15,0,5"/>

		<!-- ТАБЛИЦА РЁБЕР -->
		<dg:DataGrid Grid.Row="5"
                     ItemsSource="{Binding Edges}"
                     SelectedItem="{Binding SelectedEdge}"
                     AutoGenerateColumns="False"
                     CanUserResizeColumns="True"
                     CanUserReorderColumns="True"
                     CanUserSortColumns="True"
                     GridLinesVisibility="All"
                     BorderThickness="1"
                     MinHeight="100"
                     MaxHeight="150"
                     Margin="0,0,0,10">
			<dg:DataGrid.Columns>
				<dg:DataGridTextColumn Header="ID"
                                       Binding="{Binding Id}"
                                       Width="80"/>
				<dg:DataGridTextColumn Header="Source"
                                       Binding="{Binding SourceId}"
                                       Width="80"/>
				<dg:DataGridTextColumn Header="Target"
                                       Binding="{Binding TargetId}"
                                       Width="80"/>
				<dg:DataGridTextColumn Header="Вес"
                                       Binding="{Binding Weight}"
                                       Width="80"/>
			</dg:DataGrid.Columns>
		</dg:DataGrid>

		<!-- Панель управления рёбрами -->
		<StackPanel Grid.Row="6" Spacing="5" Margin="0,5,0,0">
			<StackPanel Orientation="Horizontal" Spacing="10">
				<TextBox Width="80" Watermark="Source"
                         Text="{Binding NewEdgeSource, UpdateSourceTrigger=PropertyChanged}"/>
				<TextBox Width="80" Watermark="Target"
                         Text="{Binding NewEdgeTarget, UpdateSourceTrigger=PropertyChanged}"/>
				<TextBox Width="80" Watermark="Weight"
                         Text="{Binding NewEdgeWeight, UpdateSourceTrigger=PropertyChanged}"/>
				<Button Content="➕ Добавить ребро"
                        Command="{Binding AddEdgeCommand}"/>
			</StackPanel>

			<StackPanel Orientation="Horizontal" Spacing="10">
				<Button Content="❌ Удалить выбранное ребро"
                        Command="{Binding DeleteEdgeCommand}"/>
				<Button Content="🔄 Обновить рёбра"
                        Command="{Binding LoadEdgesCommand}"/>
			</StackPanel>
		</StackPanel>
		

		
	</Grid>
		</TabItem>
		<!-- Вкладка 2: Визуализация графа -->
		<TabItem Header="Визуализация">
			<StackPanel Margin="10">
				<TextBlock Text="Здесь будет графическое отображение графа" FontSize="16" HorizontalAlignment="Center"/>
				<!-- Позже здесь появится Canvas или элемент для рисования -->
			</StackPanel>
		</TabItem>
	</TabControl>
</Window>